# ─── DB ────────────────────────────────────────────────────────
DB_NAME=
DB_URL=
DB_USER=

# ─── MinIO ─────────────────────────────────────────────────────
MINIO_ENDPOINT=
MINIO_ROOT_USER=
MINIO_BUCKET=

# ─── RabbitMQ ──────────────────────────────────────────────────
RABBITMQ_HOST=
RABBITMQ_PORT=
RABBITMQ_USERNAME=

# ─── JWT ───────────────────────────────────────────────────────
JWT_ACCESS_EXPIRY_MS=
JWT_REFRESH_EXPIRY_MS=

# ─── App ───────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=
OWNER_USERNAME=
OWNER_NICKNAME=

# ─── Notification ──────────────────────────────────────────────
# Firebase 자격증명은 secrets/FIREBASE_CREDENTIAL_JSON 파일로 관리
# Docker: /run/secrets/FIREBASE_CREDENTIAL_JSON 고정 경로 (application.yml 하드코딩)
# 로컬(make notification): application-local.yml → ./run/FIREBASE_CREDENTIAL_JSON
