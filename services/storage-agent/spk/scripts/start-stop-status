#!/bin/sh

set -u

PKG_NAME="${SYNOPKG_PKGNAME:-terab-agent}"
PKG_DEST="${SYNOPKG_PKGDEST:-/var/packages/${PKG_NAME}/target}"
PKG_VAR="${SYNOPKG_PKGVAR:-/var/packages/${PKG_NAME}/var}"

AGENT_BIN="${PKG_DEST}/bin/agent"
PID_FILE="${PKG_VAR}/agent.pid"
LOG_FILE="${PKG_VAR}/agent.log"
SOCKET_PATH="${PKG_VAR}/agent.sock"
RUN_USER="terab-agent"
RUN_GROUP="terab"
LOG_LEVEL="${TERAB_AGENT_LOG_LEVEL:-info}"

start_agent() {
    if status_agent >/dev/null 2>&1; then
        echo "agent already running"
        return 0
    fi
    rm -f "${SOCKET_PATH}"
    nohup su - "${RUN_USER}" -s /bin/sh -c \
        "${AGENT_BIN} -socket '${SOCKET_PATH}' -log-level '${LOG_LEVEL}' >> '${LOG_FILE}' 2>&1 & echo \$! > '${PID_FILE}'" \
        >/dev/null 2>&1
    sleep 1
    if [ ! -s "${PID_FILE}" ]; then
        echo "failed to start agent (no pid recorded)"
        return 1
    fi
    return 0
}

stop_agent() {
    if [ ! -f "${PID_FILE}" ]; then
        return 0
    fi
    pid=$(cat "${PID_FILE}" 2>/dev/null || echo "")
    if [ -z "${pid}" ]; then
        rm -f "${PID_FILE}"
        return 0
    fi
    if kill -0 "${pid}" 2>/dev/null; then
        kill -TERM "${pid}" 2>/dev/null
        i=0
        while kill -0 "${pid}" 2>/dev/null; do
            i=$((i + 1))
            if [ "${i}" -gt 10 ]; then
                kill -KILL "${pid}" 2>/dev/null
                break
            fi
            sleep 1
        done
    fi
    rm -f "${PID_FILE}" "${SOCKET_PATH}"
    return 0
}

status_agent() {
    if [ ! -f "${PID_FILE}" ]; then
        return 1
    fi
    pid=$(cat "${PID_FILE}" 2>/dev/null || echo "")
    if [ -z "${pid}" ]; then
        return 1
    fi
    if kill -0 "${pid}" 2>/dev/null; then
        return 0
    fi
    return 1
}

case "$1" in
    start)
        start_agent
        exit $?
        ;;
    stop)
        stop_agent
        exit $?
        ;;
    status)
        if status_agent; then
            echo "running"
            exit 0
        fi
        echo "stopped"
        exit 1
        ;;
    log)
        echo "${LOG_FILE}"
        exit 0
        ;;
    *)
        echo "usage: $0 {start|stop|status|log}" >&2
        exit 1
        ;;
esac
