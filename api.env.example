# App
HOST=0.0.0.0
PORT=3000
APP_BASE_URL=http://localhost:5173
LOG_MAX_FILES=30

# Database
DATABASE_URL=postgresql://terab:changeme@localhost:5432/terab

# JWT
JWT_SECRET=change-this-to-a-long-random-string
JWT_ACCESS_EXPIRY_MS=900000
JWT_REFRESH_EXPIRY_MS=604800000

# Security
PASSWORD_PEPPER=change-this-to-a-long-random-string
CORS_ALLOWED_ORIGINS=https://drive.skypark207.com
# 2FA TOTP secret encryption — base64-encoded 32 bytes (AES-256-GCM key)
# 생성: openssl rand -base64 32
TWOFA_MASTER_KEY=change-this-to-a-base64 encoding-bytes

# Owner Account (초기 구동 시 생성)
OWNER_USERNAME=owner
OWNER_NICKNAME=Owner
OWNER_PASSWORD=changeme

# Redis
REDIS_URL=redis://changeme@redis:6379

# MinIO (현재 미사용)
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_DEFAULT_BUCKETS=terab-files
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
WEB_ORIGIN=http://localhost:5173

# Storage Agent (iSCSI sidecar — systemd-only 로 배포된 storage-agent 와의 unix socket 경로)
# 운영 (NAS, systemd-only): /run/terab-agent/agent.sock — ADR-0005
# 로컬 dev: /tmp/terab-agent.sock (`make install-dev` 와 정합)
STORAGE_AGENT_SOCKET_PATH=/run/terab-agent/agent.sock

# iSCSI Portal — 사용자에게 노출되는 마운트 주소. Web UI · .ps1 스크립트가 이 값을 그대로 사용.
# storage-agent 와 동일 host 일 필요는 없으나 NAS LAN IP/포트 정확 매핑 필수
STORAGE_AGENT_PORTAL_HOST=192.168.0.5
STORAGE_AGENT_PORTAL_PORT=3260

# Drive — 본인 drive 의 mountPath 결정 시 root prefix (D1: ${root}/${driveId} 조합)
# 운영: DSM 의 volume 경로. 로컬 dev: 임시 디렉토리 또는 미사용
STORAGE_DRIVE_ROOT=/volume1/drives

# Secret Store — mount_credentials 의 CHAP password 파일 저장 위치 (D4: Docker Secret 디렉토리)
# 운영: /run/secrets (Docker Secret 표준 mount point). 로컬 dev: ${os.tmpdir()}/terab-secrets fallback
STORAGE_SECRET_DIR=/run/secrets